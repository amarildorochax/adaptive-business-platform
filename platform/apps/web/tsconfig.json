{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.web.tsbuildinfo",

    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",

    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "emitDeclarationOnly": true,
    "outDir": "./node_modules/.tmp/out",

    "paths": {
      "@/*": ["./src/*"],
      "@app/*": ["./src/app/*"],
      "@core/*": ["./src/core/*"],
      "@shared/*": ["./src/shared/*"],
      "@modules/*": ["./src/modules/*"]
    }
  },
  "include": ["src"],
  "references": [
    { "path": "../../packages/core" },
    { "path": "../../packages/shared" },
    { "path": "../../packages/platform-services" },
    { "path": "../../packages/ai" },
    { "path": "../../packages/ai-agents" },
    { "path": "../../packages/communication-hub" },
    { "path": "../../packages/content-hub" },
    { "path": "../../packages/commerce-hub" },
    { "path": "../../packages/finance-hub" },
    { "path": "../../packages/growth-hub" },
    { "path": "../../packages/analytics-hub" },
    { "path": "../../packages/automation-engine" },
    { "path": "../../packages/infrastructure" },
    { "path": "../../packages/runtime" },
    { "path": "../../packages/persistence" },
    { "path": "../api" }
  ]
}
